# Ignore everything in this directory
*
# Except this file
!.gitignore
# ...and our own hand-written Miles declarations (not EA/RAD code, so they are
# committed: the real Miles SDK is binary-only and absent, and a fresh clone
# cannot re-fetch files we wrote ourselves).  MSS/MSS.h is the one true header
# (reconstructed API surface); Mss.h and stub/mss/mss.h just forward to it.
!include/
!include/Mss.h
!include/MSS/
!include/MSS/MSS.h
!stub/
!stub/mss/
!stub/mss/mss.h
# The native unavailable implementation must survive a clean checkout.
!stub/miles.c
# Windows export definitions and cleanup remain supplied externally.
# Linux builds do not consume the Windows .def file.
# The Linux OpenAL backend and its vendored dependencies must survive a
# clean checkout (minimp3: public-domain MP3 decoder; openal/include: headers
# matching the libopenal.so.1 runtime, used when no distro dev package exists).
!stub/miles_al.cpp
!stub/minimp3/
!stub/minimp3/minimp3.h
!stub/minimp3/minimp3_ex.h
!stub/openal/
!stub/openal/include/
!stub/openal/include/AL/
!stub/openal/include/AL/al.h
!stub/openal/include/AL/alc.h
!stub/openal/include/AL/alext.h
